<!DOCTYPE html>
<html lang="ro">
<head>
    <title>Căutare pachete — Aventura Travel</title>
    <%- include('../fragmente/head.ejs') %>
    <link rel="stylesheet" href="/resurse/css/app-features.css">
    <link rel="stylesheet" href="/resurse/css/produse.css">
</head>
<body>
<%- include('../fragmente/header.ejs') %>
<main class="pagina-aplicatie">
    <h1>Motor de căutare</h1>
    <form id="form-cautare" class="panou-cautare formular-aplicatie">
        <label>Destinație <input name="destinatie" type="text" placeholder="ex: Italia, Paris" value="<%= query.destinatie || '' %>"></label>
        <label>Buget max (RON) <input name="buget_max" type="number" min="0" value="<%= query.buget_max || '' %>"></label>
        <label>Buget min (RON) <input name="buget_min" type="number" min="0" value="<%= query.buget_min || '' %>"></label>
        <label>Tip vacanță
            <select name="tip">
                <option value="">Toate</option>
                <option value="cultural">Cultural</option>
                <option value="aventura">Aventură</option>
                <option value="relaxare">Relaxare</option>
                <option value="urban">Urban / City break</option>
            </select>
        </label>
        <label>Categorie
            <select name="categorie">
                <option value="">Toate</option>
                <option value="standard">Standard</option>
                <option value="lux">Lux</option>
                <option value="familie">Familie</option>
                <option value="cuplu">Cuplu</option>
            </select>
        </label>
        <label>Persoane <input name="persoane" type="number" min="1" value="<%= query.persoane || 2 %>"></label>
        <label>De la <input name="data_start" type="date"></label>
        <label>Până la <input name="data_end" type="date"></label>
        <button type="submit" class="btn btn-primary">Caută</button>
    </form>
    <p id="numar-cautare" class="estompat"></p>
    <div id="search-results" class="grila-pachete"></div>
</main>
<%- include('../fragmente/footer.ejs') %>
<script src="/js/cautare.js"></script>
</body>
</html>
