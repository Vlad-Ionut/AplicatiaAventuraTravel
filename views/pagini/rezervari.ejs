<!DOCTYPE html>
<html lang="ro">
<head>
    <title>Rezervările mele — Aventura Travel</title>
    <%- include('../fragmente/head.ejs') %>
    <link rel="stylesheet" href="/resurse/css/app-features.css">
</head>
<body>
<%- include('../fragmente/header.ejs') %>
<main class="pagina-aplicatie">
    <span class="eticheta-pagina">Contul meu</span>
    <h1>Istoric rezervări</h1>
    <% if (!rezervari.length) { %>
    <section>
        <h2>Nu ai rezervări încă</h2>
        <p class="estompat">Explorează pachetele, alege perioada potrivită și rezervă online în câteva minute.</p>
        <a class="btn btn-primary" href="/produse">Explorează pachetele</a>
    </section>
    <% } %>
    <div class="lista-rezervari">
        <% rezervari.forEach(function(r){ %>
        <article class="rezervare-item stare-<%= r.status === 'pending' ? 'in-asteptare' : r.status %>">
            <div>
                <h2><a href="/produs/<%= r.pachet_id %>"><%= r.destinatie %></a></h2>
                <p>#<%= r.id %> · <%= r.numar_persoane %> pers ·
                   <% if (r.data_start) { %><%= r.data_start.toISOString().slice(0,10) %> → <%= r.data_end.toISOString().slice(0,10) %><% } %>
                </p>
                <p>Status: <strong><%= r.status %></strong> · Total: <strong><%= r.pret_total %> RON</strong>
                   <% if (r.plata) { %> · Plată: <%= r.plata.status %> (<%= r.plata.metoda %>)<% } %>
                </p>
            </div>
            <div class="actiuni">
                <% if (r.status === 'pending') { %>
                <a class="btn btn-primary" href="/plata/<%= r.id %>">Plătește</a>
                <% } %>
                <% if (r.status === 'pending' || r.status === 'confirmata') { %>
                <button type="button" class="btn btn-contur buton-anuleaza" data-id="<%= r.id %>">Anulează</button>
                <% } %>
            </div>
        </article>
        <% }) %>
    </div>
</main>
<%- include('../fragmente/footer.ejs') %>
<script>
document.querySelectorAll('.buton-anuleaza').forEach(btn => {
    btn.addEventListener('click', async () => {
        if (!confirm('Sigur anulezi rezervarea?')) return;
        const res = await fetch('/api/rezervari/' + btn.dataset.id + '/anulare', { method: 'POST' });
        const data = await res.json();
        if (!res.ok) alert(data.error || 'Eroare');
        else location.reload();
    });
});
</script>
</body>
</html>
