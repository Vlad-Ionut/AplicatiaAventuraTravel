<!DOCTYPE html>
<html lang="ro">
<head>
    <title>Autentificare — Aventura Travel</title>
    <meta name="description" content="Autentificare Aventura Travel">
    <%- include('../fragmente/head.ejs') %>
    <link rel="stylesheet" href="/resurse/css/app-features.css">
</head>
<body>
<%- include('../fragmente/header.ejs') %>
<main class="pagina-aplicatie">
    <section class="card-autentificare">
        <span class="eticheta-pagina">Cont client</span>
        <h1>Autentificare</h1>
        <p class="introducere">Intră în cont pentru rezervări, wishlist, notificări și recomandări personalizate.</p>
        <p class="estompat">Conturi demo: admin@aventuratravel.ro / admin123 · client@aventuratravel.ro / client123</p>
        <form id="formular-autentificare" class="formular-aplicatie">
            <label>Email <input type="email" name="email" required autocomplete="username"></label>
            <label>Parolă <input type="password" name="parola" required autocomplete="current-password"></label>
            <p id="eroare-autentificare" class="eroare-formular" hidden></p>
            <button type="submit" class="btn btn-primary">Intră în cont</button>
        </form>
        <p>Nu ai cont? <a href="/register">Înregistrează-te</a></p>
        <p class="estompat">Autentificarea folosește JWT în cookie securizat, păstrând rolurile Administrator, Angajat și Client.</p>
    </section>
</main>
<%- include('../fragmente/footer.ejs') %>
<script>
document.getElementById('formular-autentificare').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const err = document.getElementById('eroare-autentificare');
    err.hidden = true;
    const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: fd.get('email'), parola: fd.get('parola') })
    });
    const data = await res.json();
    if (!res.ok) { err.textContent = data.error || 'Eroare'; err.hidden = false; return; }
    const redirect = new URLSearchParams(location.search).get('redirect') || '/';
    location.href = redirect;
});
</script>
</body>
</html>
